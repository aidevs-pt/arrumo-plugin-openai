{
  "schemaVersion": 2,
  "pluginId": "openai",
  "endpoint": "https://api.openai.com/v1/audio/transcriptions",
  "credentialSetting": "api-key",
  "credentialHeader": "authorization",
  "credentialPrefix": "Bearer ",
  "maxAudioBytes": 25000000,
  "fileField": "file",
  "form": {
    "model": "gpt-transcribe"
  },
  "response": {
    "text": "/text",
    "language": "/languages",
    "languageItem": "/code"
  }
}
